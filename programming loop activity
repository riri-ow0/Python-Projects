while True:
    message = input("\nPlease enter your message: ")
    try:
        x = int(input("Enter your first number: "))
        y = int(input("Enter your second number: "))
    except ValueError:
        print("Invalid input, please try again")
        continue
    print("\nLast Name, First Name")
    print(f"Message: {message}")
    print(f"Concatenation: {x + y}")
    print(f"Product = {x * y}")
    try:
        result = x / y
        if result == 0 or result != int(result):
            print("Error: invalid quotient")
        else:
            print(f"Quotient = {result:.0f}")
    except ZeroDivisionError:
        print("Can't divide by 0")

    if x > y:
        print("\nMultiplication Table")
        for x in range(1, x + 1):
            print(f"{x} x {y} = {x * y}")
    else:
        print("\nMultiplication Table")
        for x in range(1, x + 1):
            print(f"{x} x {y} = {x * y}")

    retry = input("Would you like to try again? (y/n): ")
    if retry.lower() == "y" or retry.lower() == "yes":
        continue
    elif retry.lower() == "n" or retry.lower() == "no":
        print("\nGoodbye.")
        break
    else:
        print("\nInvalid/incomplete input, terminating program...\n\n[Program terminated.]")
        break
